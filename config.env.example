# deploykit configuration — copy to config.env and fill in your org's values.
# config.env is git-ignored. NEVER commit real tokens, keys, or hostnames.

# --- RustDesk (remote support) ---
RUSTDESK_HOST="rustdesk.example.com"
RUSTDESK_KEY="<your-rustdesk-public-key>"
RUSTDESK_RELAY="${RUSTDESK_HOST}"

# --- Wazuh (SIEM agent) ---
WAZUH_ENROLL_HOST="wazuh.example.com"
WAZUH_ENROLL_PASSWORD=""        # leave blank — setup prompts securely at runtime
WAZUH_MANAGER="wazuh.example.com"

# --- Chrome Browser Cloud Management (per-org enrollment tokens) ---
CHROME_TOKEN_CC="<chrome-cbcm-enrollment-token>"
CHROME_TOKEN_VC="<chrome-cbcm-enrollment-token>"

# --- FleetDM (osquery fleet) ---
FLEET_URL="https://fleet.example.com"

# --- Installer sources (runtime fetch — no binaries committed) ---
# Chrome downloads from Google by default; RustDesk auto-resolves the latest GitHub release.
# Fleet's agent is org-specific (built with fleetctl, enroll secret baked in) — host the packages
# yourself and point these at them: macOS uses FLEET_PKG_URL (.pkg), Windows uses FLEET_MSI_URL (.msi).
# Leave blank to skip Fleet.
CHROME_PKG_URL="https://dl.google.com/chrome/mac/universal/stable/GGRO/googlechrome.pkg"
FLEET_PKG_URL=""
FLEET_MSI_URL=""

# --- Cloudflare Access (optional) — if the installer URLs above sit behind Access, put the
# service token here. The installer sends these headers ONLY to requests matching CF_ACCESS_HOST.
CF_ACCESS_HOST=""
CF_ACCESS_CLIENT_ID=""
CF_ACCESS_CLIENT_SECRET=""
